.{
    .name = .zinet,
    .version = "0.1.0",
    .fingerprint = 0x3ec57b17431a6ac8,
    .minimum_zig_version = "0.17.0-dev.1476+91a29d707",
    .dependencies = .{
        // Only used by `-Dio=zio`, which points the tests, examples and
        // benchmarks at a fiber runtime. Lazy, so `zig build` without that flag
        // neither downloads nor builds it, and the library keeps depending on
        // nothing but the standard library.
        .zio = .{
            .url = "git+https://github.com/lalinsky/zio#407427a21f3ac0ecb20847e146535465d7ad3d16",
            .hash = "zio-0.16.0-xHbVVIvlIwAtXnRvRtdni09wYZVJgHuXN4YKoOKIwHsr",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "examples",
        "bench",
        // `tools` and `scripts` are here so a consumer can run the checks this
        // repository holds itself to — `zig build mutate` and the protobuf interop
        // script — rather than only the library.
        //
        // The commit that added them gave a different reason and it was wrong: it
        // claimed `build.zig` naming `tools/mutate.zig` unconditionally meant a
        // package without it could not be configured. `b.path` does not read the
        // file, and a consumer that never runs the `mutate` step never needs it —
        // checked by deleting `tools` from an extracted package, whose build then
        // succeeded. The paths stay, for the honest reason.
        "tools",
        "scripts",
        "docs",
        "LICENSE",
        "README.md",
        // The implementation records the README points at. They are the argument
        // this repository makes, so shipping the code without them ships the
        // conclusions without the reasoning.
        "HTTP2.md",
        "HTTP3.md",
        "TLS.md",
        "REVIEW.md",
    },
}
