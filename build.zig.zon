.{
    .name = .zinet,
    .version = "0.1.0",
    .fingerprint = 0x3ec57b17431a6ac8,
    .minimum_zig_version = "0.17.0-dev.1476+91a29d707",
    .dependencies = .{
        // Only used by `-Dio=zio`, which points the tests, examples and
        // benchmarks at a fiber runtime. Lazy, so `zig build` without that flag
        // neither downloads nor builds it, and the library keeps depending on
        // nothing but the standard library.
        .zio = .{
            .url = "git+https://github.com/lalinsky/zio#407427a21f3ac0ecb20847e146535465d7ad3d16",
            .hash = "zio-0.16.0-xHbVVIvlIwAtXnRvRtdni09wYZVJgHuXN4YKoOKIwHsr",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "examples",
        "bench",
        // `build.zig` names `tools/mutate.zig` unconditionally, so a package
        // missing it cannot be configured by a consumer at all.
        "tools",
        "scripts",
        "docs",
        "LICENSE",
        "README.md",
        // The implementation records the README points at. They are the argument
        // this repository makes, so shipping the code without them ships the
        // conclusions without the reasoning.
        "HTTP2.md",
        "HTTP3.md",
        "TLS.md",
        "REVIEW.md",
    },
}
